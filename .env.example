# Copia a .env (nunca commitear el .env real).
# Supabase LOCAL (supabase start): la anon key la muestra el CLI al iniciar.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=pega-aqui-la-anon-key-local

# Sin estas variables la app funciona 100% en modo solitario (offline-first).
# El multijugador real entre dispositivos requiere que el backend sea alcanzable
# (misma WiFi con la IP LAN en vez de 127.0.0.1, o proyecto gratuito en supabase.com).
